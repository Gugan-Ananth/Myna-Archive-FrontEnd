# Nest API base URL (no trailing slash, no /api/v1 — the client appends /api/v1).
# Local: run Myna-Archive-Backend on port 3001 with CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Must match the backend AUTH_TOKEN_SECRET. Server-only (proxy verifies the session).
AUTH_TOKEN_SECRET=

# Production / shared staging example:
# NEXT_PUBLIC_API_URL=https://myna-archive.duckdns.org

# Media: browser uploads go direct to Bunny.net (Edge Storage PUT / Stream TUS).
# Nest only issues credentials + finalizes Archive Items — no Cloudinary.
# Configure Bunny on the backend (.env); no Bunny secrets needed in the frontend.

# Bunny Stream library ID (numeric). Required for Premium JIT playback via the
# official Bunny embed (player.mediadelivery.net). Find it in Stream → Library.
# NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=123456
